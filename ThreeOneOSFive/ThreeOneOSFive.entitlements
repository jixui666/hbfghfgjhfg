<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by worse_query: the App Group container is the thing whose
	     Library/Caches gets pointed at the target path. Keep this identifier in
	     sync with WQ_DEFAULT_GROUP in exploit/worse_query.m. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.yangjiii.3105</string>
	</array>
</dict>
</plist>
